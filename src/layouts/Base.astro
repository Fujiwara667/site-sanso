---
// Gabarit commun à toutes les pages : <head>, en-tête, pied de page.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import entreprise from '../data/entreprise.json';

interface Props {
  titre: string; // Titre de l'onglet (sans « — SANSO Concept »)
  description?: string;
}
const { titre, description = entreprise.descriptionSite } = Astro.props;
const titreComplet = `${titre} — ${entreprise.nom}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/aptos-display.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_CH" />
  </head>
  <body>
    <a class="skip" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
