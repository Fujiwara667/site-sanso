---
import type { Projet } from '../data/projets';
import DiaporamaProjet from './DiaporamaProjet.astro';
interface Props {
  projet: Projet;
  niveauTitre?: 'h2' | 'h3';
}
const { projet, niveauTitre = 'h2' } = Astro.props;
const Titre = niveauTitre;
const titre = `${projet.numero} / ${projet.nom}`;
const SousTitre = niveauTitre === 'h2' ? 'h3' : 'h4';
const domaines = { CB: 'Construction bois', EB: 'Étude bois', PI: 'Protection incendie' };
---

<article class="project-record">
  <div class="project-information">
    <header class="project-identity">
      <Titre class="project-name">{titre}</Titre>
      <p class="project-location">{projet.lieu}</p>
    </header>
    <p class="project-domains">{projet.domaines.map((code) => domaines[code]).join(' / ')}</p>
    <SousTitre class="project-work-title">{projet.titreTravaux}</SousTitre>
    <p class="project-works">{projet.travaux}</p>
  </div>
  <DiaporamaProjet images={projet.images} titre={titre} />
</article>
