---
// Gabarit commun aux 3 pages métier (Construction bois, Étude bois, Protection incendie).
// Le contenu de chaque page est défini dans son fichier src/pages/<page>.astro.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Cta from './Cta.astro';

interface Props {
  titre: string; // ex. « Construction bois »
  surtitre: string; // petite ligne en capitales au-dessus du grand titre
  verbe: string; // grand titre, ex. « Construire. »
  accroche: string;
  numero: number;
  photo: ImageMetadata;
  photoAlt: string;
  intro: string;
  prestations: { titre: string; texte: string }[];
  liens: { href: string; label: string }[]; // liens vers les 2 autres métiers
}
const p = Astro.props;
---

<Base titre={p.titre}>
  <section class="service-hero">
    <div class="wrap service-hero-title">
      <p class="eyebrow">{p.surtitre}</p>
      <h1>{p.verbe}</h1>
      <div class="service-lead">
        <p>{p.accroche}</p>
        <span class="eyebrow">0{p.numero} / COMPÉTENCE</span>
      </div>
    </div>
    <div class="service-photo">
      <Image src={p.photo} alt={p.photoAlt} widths={[800, 1400, 1920]} quality={70} sizes="100vw" loading="eager" />
    </div>
  </section>

  <section class="wrap service-intro">
    <h2>{p.titre}.</h2>
    <p>{p.intro}</p>
  </section>

  <section class="peach">
    <div class="wrap prestations">
      <p class="eyebrow">NOTRE ACCOMPAGNEMENT</p>
      {p.prestations.map((s, i) => (
        <div class="prestation">
          <span class="eyebrow">0{i + 1}</span>
          <h3>{s.titre}</h3>
          <p>{s.texte}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap related">
    <div>
      <p class="eyebrow">DU BUREAU AU CHANTIER</p>
      <h2>
        Penser l’ensemble.
        <br />
        Soigner le détail.
      </h2>
    </div>
    <div>
      {p.liens.map((l) => (
        <a href={l.href}>
          <span>{l.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <Cta />
</Base>
