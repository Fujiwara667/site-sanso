---
// Gabarit commun aux 3 pages métier (Construction bois, Étude bois, Protection incendie).
// Le contenu de chaque page est défini dans son fichier src/pages/<page>.astro.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Cta from './Cta.astro';

interface Props {
  titre: string; // ex. « Construction bois »
  surtitre: string; // petite ligne en capitales au-dessus du grand titre
  accroche: string;
  numero: number;
  photo: ImageMetadata;
  photoAlt: string;
  typeVisuel?: 'document' | 'signalisation';
  precision?: string;
  texteEnBas?: boolean;
  prestations: { titre: string; texte: string }[];
  liens: { href: string; label: string; numero: number }[]; // liens vers les 2 autres métiers
}
const p = Astro.props;
const codes = ['CB', 'EB', 'PI'];
const code = codes[p.numero - 1];
---

<Base titre={p.titre} description={p.accroche}>
  <section class:list={['service-hero', p.texteEnBas && 'service-hero--lower-third']}>
    <div class="wrap service-hero-title">
      <p class="eyebrow">{p.surtitre}</p>
      <div class="service-heading">
        <h1>{p.titre}</h1>
        <p class="introduction">{p.accroche}</p>
      </div>
    </div>
    <div class:list={['service-photo', 'wrap', p.typeVisuel && `service-photo--${p.typeVisuel}`]}>
      <Image
        src={p.photo}
        alt={p.photoAlt}
        widths={[800, 1400, 1920]}
        quality={p.typeVisuel === 'document' ? 85 : 70}
        sizes="100vw"
        loading="eager"
      />
    </div>
  </section>

  {p.texteEnBas && <p class="wrap service-mobile-introduction">{p.accroche}</p>}

  <section>
    <div class="wrap prestations">
      <h2>Prestations</h2>
      {p.prestations.map((s, i) => (
        <div class="prestation">
          <span class="eyebrow">
            {code}-0{i + 1}
          </span>
          <h3>{s.titre}</h3>
          <p>{s.texte}</p>
        </div>
      ))}
      {p.precision && <p class="service-note">{p.precision}</p>}
    </div>
  </section>

  <section class="wrap related">
    <div>
      <h2>Nos autres métiers</h2>
    </div>
    <div>
      {p.liens.map((l) => (
        <a href={l.href}>
          <span class="eyebrow">{codes[l.numero - 1]}</span>
          <span>{l.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <Cta prestation={code} />
</Base>
