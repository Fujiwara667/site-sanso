---
// En-tête : logo + navigation (bureau) + menu mobile.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

// Liens du menu — modifier ici pour ajouter / renommer une page.
// Les pages métiers et À propos sont accessibles depuis l'accueil et le pied de page.
const liens = [
  { href: '/projets/', label: 'Réalisations' },
  { href: '/contact/', label: 'Contact ↗' },
];
const courant = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="header">
  <a class="logo" href="/" aria-label="SANSO Concept — Accueil">
    <Image src={logo} alt="SANSO Concept" width={348} loading="eager" />
  </a>
  <nav class="desktop-nav" aria-label="Navigation principale">
    <div>
      {liens.map((l) => (
        <a href={l.href} aria-current={courant === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </div>
  </nav>
  <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-nav">
    Menu +
  </button>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Navigation mobile" hidden>
    {liens.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>
</header>

<script>
  // Ouverture / fermeture du menu mobile
  const bouton = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-nav');
  bouton?.addEventListener('click', () => {
    const ouvert = bouton.getAttribute('aria-expanded') === 'true';
    bouton.setAttribute('aria-expanded', String(!ouvert));
    bouton.textContent = ouvert ? 'Menu +' : 'Fermer ×';
    if (menu) menu.hidden = ouvert;
  });
</script>
