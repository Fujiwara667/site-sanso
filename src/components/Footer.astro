---
// Pied de page
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import entreprise from '../data/entreprise.json';
const annee = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <a class="footer-logo" href="/" aria-label="Accueil">
        <Image src={logo} alt="SANSO CONCEPT" width={420} loading="eager" />
      </a>
      <p>
        Étudier.
        <br />
        <span>Construire.</span>
      </p>
      <div class="footer-contact">
        <a href={`mailto:${entreprise.email}`}>{entreprise.email}</a>
        <a href={`tel:${entreprise.telephoneLien}`}>{entreprise.telephone}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>
        SANSO CONCEPT / {entreprise.npa} {entreprise.localite.toUpperCase()}
      </p>
      <div>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
        <span>© {annee} SANSO CONCEPT</span>
      </div>
    </div>
  </div>
</footer>
