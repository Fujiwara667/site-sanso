---
// Page d'accueil
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import ProjetReference from '../components/ProjetReference.astro';
import { referencesPubliees } from '../data/projets';
const [projetRecent] = referencesPubliees;
import photoHero from '../assets/photos/hero-accueil-actualise.jpg';

const codes = ['CB', 'EB', 'PI'];
const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Construction, rénovation et transformation d’ouvrages en bois.',
  },
  {
    href: '/etude-bois/',
    titre: 'Étude bois',
    texte: 'Études, dimensionnements et plans pour les ouvrages en bois.',
  },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Concepts, plans et accompagnement pour les bâtiments neufs et existants.',
  },
];
---

<Base
  titre="Étudier. Construire."
  description="Nous réalisons vos travaux de construction, de rénovation et de transformation en bois. Nous prenons également en charge vos études bois et vos mandats de protection incendie."
>
  <section class="home-hero">
    <div class="hero-top wrap">
      <div class="hero-signature">
        <h1>
          <span>Étudier.</span>
          <span>Construire.</span>
        </h1>
        <p class="eyebrow">CONSTRUCTION BOIS / ÉTUDE BOIS / PROTECTION INCENDIE</p>
      </div>
      <div class="hero-note">
        <p>
          Nous réalisons vos travaux de construction, de rénovation et de transformation en bois. Nous prenons également
          en charge vos études bois et vos mandats de protection incendie.
        </p>
        <a class="text-link" href="/contact/">
          Contactez-nous <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero-photo wrap">
      <Image
        src={photoHero}
        alt="Revêtement en lames de bois séparées par des joints noirs, en noir et blanc"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="photo-caption">
        <span>PUIDOUX / SUISSE ROMANDE</span>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / PRESTATIONS</p>
        <h2>Nos métiers</h2>
      </div>
    </div>
    <div class="services-grid">
      {metiers.map((m, i) => (
        <a class="service-card" href={m.href}>
          <div class="card-top">
            <span class="eyebrow">{codes[i]}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir les prestations</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach" id="a-propos" aria-labelledby="company-title">
    <div class="wrap company-grid">
      <div class="company-heading">
        <p class="eyebrow">02 / ENTREPRISE</p>
        <h2 id="company-title">SANSO CONCEPT</h2>
      </div>
      <div class="prose company-presentation">
        <p>
          SANSO CONCEPT est une entreprise active dans la construction bois, les études techniques et la protection
          incendie.
        </p>
        <p>
          Notre particularité réside dans la complémentarité de ces compétences. L’expérience du chantier nourrit notre
          réflexion technique, tandis que la maîtrise de la conception apporte une vision plus globale de la
          réalisation.
        </p>
        <p>
          Nous accordons une importance particulière à la précision, à la qualité du travail et à la pertinence des
          solutions proposées. Notre approche se veut pragmatique, transparente et adaptée aux réalités de chaque
          projet.
        </p>
        <p>
          Qu’il s’agisse d’un mandat d’étude ou de travaux de construction, nous avançons avec les mêmes exigences et la
          volonté de construire des relations de confiance durables.
        </p>
      </div>
      <div class="company-direction">
        <p class="eyebrow">DIRECTION</p>
        <h3>Nicolas Sansonnens</h3>
        <p>
          Technicien ES en construction bois
          <br />
          Spécialiste en protection incendie AEAI
        </p>
      </div>
      <p class="company-signature eyebrow">ÉTUDIER. CONSTRUIRE.</p>
    </div>
  </section>

  <section class="wrap home-projects">
    <div class="home-projects-heading">
      <div>
        <p class="eyebrow">03 / PROJETS</p>
        {projetRecent && <h2>Projet récent</h2>}
      </div>
      <a class="text-link" href="/projets/">
        Voir tous les projets <span aria-hidden="true">↗</span>
      </a>
    </div>
    {projetRecent && <ProjetReference projet={projetRecent} niveauTitre="h3" />}
  </section>
  <Cta />
</Base>
