---
// Page d'accueil
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import ProjetCarte from '../components/ProjetCarte.astro';
import photoHero from '../assets/photos/accueil-chantier-leman.jpg';

// Projets marqués « accueil: true », triés par ordre
const projets = (await getCollection('projets'))
  .filter((p) => p.data.accueil && !p.data.exemple)
  .sort((a, b) => a.data.ordre - b.data.ordre);

const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Charpente, toiture, ossature bois, isolation et revêtements.',
  },
  {
    href: '/etude-bois/',
    titre: 'Étude bois',
    texte: 'Conception, dimensionnement, plans et appels d’offres.',
  },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Conseil, concepts, plans et assurance qualité.',
  },
];
---

<Base
  titre="Étudier. Construire."
  description="SANSO CONCEPT réunit la construction bois, l’étude bois et la protection incendie. Basés à Puidoux, nous intervenons en Suisse romande."
>
  <section class="home-hero">
    <div class="hero-top wrap">
      <div>
        <p class="eyebrow">CONSTRUCTION BOIS / ÉTUDE BOIS / PROTECTION INCENDIE</p>
        <h1>
          <span>Étudier.</span>
          <span>Construire.</span>
        </h1>
      </div>
      <div class="hero-note">
        <p>
          SANSO CONCEPT réunit la construction bois, l’étude bois et la protection incendie. Basés à Puidoux, nous
          intervenons en Suisse romande.
        </p>
        <a class="text-link" href="/contact/">
          Contactez-nous <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <Image
        src={photoHero}
        alt="Levage d’un élément de construction bois sur un chantier au-dessus du Léman"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="photo-caption">
        <span>PUIDOUX / SUISSE ROMANDE</span>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / MÉTIERS</p>
        <h2>Nos métiers</h2>
      </div>
    </div>
    <div class="services-grid">
      {metiers.map((m, i) => (
        <a class="service-card" href={m.href}>
          <div class="card-top">
            <span class="eyebrow">0{i + 1}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir les prestations</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach">
    <div class="wrap approach-grid">
      <div>
        <p class="eyebrow">02 / ENTREPRISE</p>
        <h2>SANSO CONCEPT</h2>
      </div>
      <div>
        <p>
          Nous concevons les ouvrages en bois et réalisons les travaux. Nous assurons également des mandats de
          protection incendie pour tous types de bâtiments.
        </p>
        <p>Ces prestations peuvent être confiées séparément ou réunies dans un même mandat.</p>
        <a class="text-link" href="/a-propos/">
          À propos <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {projets.length > 0 && (
    <section class="wrap selected">
      <div class="section-heading">
        <div>
          <p class="eyebrow">03 / PROJETS</p>
          <h2>Projets</h2>
        </div>
        <a class="text-link" href="/projets/">
          Voir les projets <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="project-list">
        {projets.map((p, i) => (
          <ProjetCarte projet={p} numero={i + 1} />
        ))}
      </div>
    </section>
  )}
  <Cta />
</Base>
