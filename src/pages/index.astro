---
// Page d'accueil
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import photoHero from '../assets/photos/accueil-chantier-leman.jpg';

const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Construction, rénovation, transformation : ossature bois, charpente, enveloppe et revêtements.',
  },
  {
    href: '/etude-bois/',
    titre: 'Étude bois',
    texte: 'Avant-projets, conception, dossiers d’appels d’offres, dimensionnement et plans.',
  },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Conseil et suivi technique, assurance qualité et mise en conformité des bâtiments.',
  },
];
---

<Base
  titre="Étudier. Construire."
  description="Construction, rénovation et transformation en bois. Études techniques et protection incendie, de l’avant-projet au suivi des travaux."
>
  <section class="home-hero">
    <div class="hero-top wrap">
      <div>
        <p class="eyebrow">CONSTRUCTION BOIS / ÉTUDE BOIS / PROTECTION INCENDIE</p>
        <h1>
          <span>Étudier.</span>
          <span>Construire.</span>
        </h1>
      </div>
      <div class="hero-note">
        <p>
          Construction, rénovation et transformation en bois. Études techniques et protection incendie, de
          l’avant-projet au suivi des travaux.
        </p>
        <a class="text-link" href="/contact/">
          Contactez-nous <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <Image
        src={photoHero}
        alt="Levage d’un élément de construction bois sur un chantier au-dessus du Léman"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="photo-caption">
        <span>PUIDOUX / SUISSE ROMANDE</span>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / PRESTATIONS</p>
        <h2>Nos domaines d’intervention</h2>
      </div>
    </div>
    <div class="services-grid">
      {metiers.map((m, i) => (
        <a class="service-card" href={m.href}>
          <div class="card-top">
            <span class="eyebrow">01-0{i + 1}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir les prestations</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach" id="a-propos">
    <div class="wrap approach-grid">
      <div>
        <p class="eyebrow">02 / ENTREPRISE</p>
        <h2>SANSO CONCEPT</h2>
      </div>
      <div class="prose">
        <p>
          Basé à Puidoux, SANSO CONCEPT est une entreprise de construction bois et un bureau d’étude bois et de
          protection incendie. Nous intervenons en Suisse romande auprès des particuliers, des architectes et des
          entreprises.
        </p>
        <p>
          Nous réalisons des travaux de construction, de rénovation et de transformation. Notre bureau prépare les
          avant-projets, les dossiers d’appels d’offres, les calculs de structure et les plans nécessaires à leur
          exécution.
        </p>
        <p>
          En protection incendie, nous assurons le conseil et le suivi technique, les mandats d’assurance qualité ainsi
          que le contrôle de l’existant et la définition des mesures de mise en conformité. Ces prestations concernent
          tous types de bâtiments.
        </p>
        <p>Les trois activités peuvent être confiées séparément ou réunies dans un même mandat.</p>
        <div class="company-contact">
          <p class="eyebrow">02-01 / DIRECTION</p>
          <h3>Nicolas Sansonnens</h3>
          <p>
            Technicien ES en construction bois
            <br />
            Spécialiste en protection incendie AEAI
          </p>
          <a class="text-link" href="/contact/">
            Contactez-nous <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>
