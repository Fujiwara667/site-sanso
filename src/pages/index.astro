---
// Page d'accueil
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import photoHero from '../assets/photos/accueil-chantier-leman.jpg';

const codes = ['CB', 'EB', 'PI'];
const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Réalisation d’ouvrages neufs et travaux sur l’existant.',
  },
  {
    href: '/etude-bois/',
    titre: 'Étude bois',
    texte: 'Développement technique de vos projets bois.',
  },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Protection incendie des bâtiments neufs et existants.',
  },
];
---

<Base
  titre="Étudier. Construire."
  description="Nous réalisons vos travaux de construction, de rénovation et de transformation en bois. Nous prenons également en charge vos études bois et vos mandats de protection incendie."
>
  <section class="home-hero">
    <div class="hero-top wrap">
      <div class="hero-signature">
        <h1>
          <span>Étudier.</span>
          <span>Construire.</span>
        </h1>
        <p class="eyebrow">CONSTRUCTION BOIS / ÉTUDE BOIS / PROTECTION INCENDIE</p>
      </div>
      <div class="hero-note">
        <p>
          Nous réalisons vos travaux de construction, de rénovation et de transformation en bois. Nous prenons également
          en charge vos études bois et vos mandats de protection incendie.
        </p>
        <a class="text-link" href="/contact/">
          Contactez-nous <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <Image
        src={photoHero}
        alt="Levage d’un élément de construction bois sur un chantier au-dessus du Léman"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="photo-caption">
        <span>PUIDOUX / SUISSE ROMANDE</span>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / PRESTATIONS</p>
        <h2>Nos domaines d’intervention</h2>
      </div>
    </div>
    <div class="services-grid">
      {metiers.map((m, i) => (
        <a class="service-card" href={m.href}>
          <div class="card-top">
            <span class="eyebrow">{codes[i]}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir les prestations</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach" id="a-propos">
    <div class="wrap approach-grid">
      <div>
        <p class="eyebrow">02 / ENTREPRISE</p>
        <h2>SANSO CONCEPT</h2>
      </div>
      <div class="prose">
        <p>
          SANSO CONCEPT réunit trois compétences complémentaires : l’étude technique, la construction bois et la
          protection incendie.
        </p>
        <p>
          Notre approche associe la précision de la conception à l’expérience concrète du terrain, avec une même
          exigence du premier croquis à la réalisation.
        </p>
        <div class="company-values">
          <h3>Nos valeurs</h3>
          <dl>
            <div>
              <dt>Précision</dt>
              <dd>Le souci du détail et la rigueur technique à chaque étape.</dd>
            </div>
            <div>
              <dt>Savoir-faire</dt>
              <dd>Une connaissance du métier qui relie la réflexion à la pratique.</dd>
            </div>
            <div>
              <dt>Authenticité</dt>
              <dd>Des échanges directs, une approche transparente et sans artifices.</dd>
            </div>
            <div>
              <dt>Engagement</dt>
              <dd>Le respect des engagements et le goût du travail bien fait.</dd>
            </div>
          </dl>
        </div>
        <div class="company-philosophy">
          <h3>Notre philosophie</h3>
          <p>
            Nous croyons aux solutions réfléchies, aux réalisations soignées et à la cohérence entre ce qui est imaginé
            et ce qui est construit.
          </p>
        </div>
        <div class="company-contact">
          <p class="eyebrow">DIRECTION</p>
          <h3>Nicolas Sansonnens</h3>
          <p>
            Technicien ES en construction bois
            <br />
            Spécialiste en protection incendie AEAI
          </p>
          <a class="text-link" href="/contact/">
            Contactez-nous <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>
