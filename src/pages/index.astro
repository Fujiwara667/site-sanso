---
// Page d'accueil
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import ProjetCarte from '../components/ProjetCarte.astro';
import photoHero from '../assets/photos/accueil-chantier-leman.jpg';

// Projets marqués « accueil: true », triés par ordre
const projets = (await getCollection('projets'))
  .filter((p) => p.data.accueil)
  .sort((a, b) => a.data.ordre - b.data.ordre);

const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Charpente, ossature, rénovation de toiture, isolation et revêtements.',
  },
  {
    href: '/etude-bois/',
    titre: 'Étude bois',
    texte: 'Conception, dimensionnement, plans d’exécution et dossiers d’appels d’offres.',
  },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Conseil, concepts, plans et suivi des mesures de protection incendie.',
  },
];
---

<Base
  titre="Étudier. Construire."
  description="Basé à Puidoux, SANSO CONCEPT réalise vos travaux de construction bois et vous accompagne pour vos études techniques et vos mandats de protection incendie en Suisse romande."
>
  <section class="home-hero">
    <div class="hero-top wrap">
      <div>
        <p class="eyebrow">CONSTRUCTION BOIS / ÉTUDE BOIS / PROTECTION INCENDIE</p>
        <h1>
          <span>Étudier.</span>
          <span>Construire.</span>
        </h1>
      </div>
      <div class="hero-note">
        <p>
          Basé à Puidoux, SANSO CONCEPT réalise vos travaux de construction bois et vous accompagne pour vos études
          techniques et vos mandats de protection incendie en Suisse romande.
        </p>
        <a class="text-link" href="/contact/">
          Contactez-nous <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <Image
        src={photoHero}
        alt="Levage d’un élément de construction bois sur un chantier au-dessus du Léman"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="photo-caption">
        <span>PUIDOUX / SUISSE ROMANDE</span>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / NOS MÉTIERS</p>
        <h2>Nos prestations.</h2>
      </div>
    </div>
    <div class="services-grid">
      {metiers.map((m, i) => (
        <a class="service-card" href={m.href}>
          <div class="card-top">
            <span class="eyebrow">0{i + 1}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir les prestations</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach">
    <div class="wrap approach-grid">
      <div>
        <h2>SANSO CONCEPT.</h2>
      </div>
      <div>
        <p>
          Nous réunissons la construction bois, l’étude bois et la protection incendie au sein d’une même structure. Ces
          prestations peuvent être confiées séparément ou associées selon les besoins de votre projet. Notre
          connaissance du chantier nous permet de proposer des solutions concrètes et de préparer leur mise en œuvre.
        </p>
        <a class="text-link" href="/a-propos/">
          À propos de SANSO CONCEPT <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="wrap selected">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / NOS PROJETS</p>
        <h2>Projets.</h2>
      </div>
      <a class="text-link" href="/projets/">
        Voir tous les projets <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-list">
      {projets.map((p, i) => (
        <ProjetCarte projet={p} numero={i + 1} />
      ))}
    </div>
  </section>

  <Cta />
</Base>
