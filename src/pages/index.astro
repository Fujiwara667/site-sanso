---
// Page d'accueil
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import photoHero from '../assets/photos/accueil-chantier-leman.jpg';

const codes = ['CB', 'EB', 'PI'];
const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Construction, rénovation et transformation d’ouvrages en bois.',
  },
  {
    href: '/etude-bois/',
    titre: 'Étude bois',
    texte: 'Avant-projets, conception, dossiers d’appels d’offres, dimensionnement et plans.',
  },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Conseil et suivi technique, assurance qualité et mise en conformité des bâtiments.',
  },
];
---

<Base
  titre="Étudier. Construire."
  description="Nous réalisons vos travaux de construction, de rénovation et de transformation en bois. Nous prenons également en charge vos études bois et vos mandats de protection incendie."
>
  <section class="home-hero">
    <div class="hero-top wrap">
      <div class="hero-signature">
        <h1>
          <span>Étudier.</span>
          <span>Construire.</span>
        </h1>
        <p class="eyebrow">CONSTRUCTION BOIS / ÉTUDE BOIS / PROTECTION INCENDIE</p>
      </div>
      <div class="hero-note">
        <p>
          Nous réalisons vos travaux de construction, de rénovation et de transformation en bois. Nous prenons également
          en charge vos études bois et vos mandats de protection incendie.
        </p>
        <a class="text-link" href="/contact/">
          Contactez-nous <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <Image
        src={photoHero}
        alt="Levage d’un élément de construction bois sur un chantier au-dessus du Léman"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="photo-caption">
        <span>PUIDOUX / SUISSE ROMANDE</span>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / PRESTATIONS</p>
        <h2>Nos domaines d’intervention</h2>
      </div>
    </div>
    <div class="services-grid">
      {metiers.map((m, i) => (
        <a class="service-card" href={m.href}>
          <div class="card-top">
            <span class="eyebrow">{codes[i]}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir les prestations</span>
        </a>
      ))}
    </div>
  </section>

  <section class="approach" id="a-propos">
    <div class="wrap approach-grid">
      <div>
        <p class="eyebrow">02 / ENTREPRISE</p>
        <h2>SANSO CONCEPT</h2>
      </div>
      <div class="prose">
        <p>
          Chaque mandat commence par un échange pour préciser vos besoins et l’étendue de notre intervention. Vous
          disposez d’un interlocuteur direct pour les décisions techniques et l’organisation des travaux qui nous sont
          confiés.
        </p>
        <p>
          Nous préparons les interventions en tenant compte du bâtiment, du budget et des contraintes du chantier. Les
          choix constructifs, les détails et les interfaces sont examinés avant leur mise en œuvre.
        </p>
        <div class="company-contact">
          <p class="eyebrow">DIRECTION</p>
          <h3>Nicolas Sansonnens</h3>
          <p>
            Technicien ES en construction bois
            <br />
            Spécialiste en protection incendie AEAI
          </p>
          <a class="text-link" href="/contact/">
            Contactez-nous <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <Cta />
</Base>
