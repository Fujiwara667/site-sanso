---
// Page d'accueil
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import ProjetCarte from '../components/ProjetCarte.astro';
import entreprise from '../data/entreprise.json';
import photoHero from '../assets/photos/accueil-chantier-leman.jpg';
import photoConstruction from '../assets/photos/construction-bois.jpg';
import photoEtude from '../assets/photos/etude-bois.png';
import photoIncendie from '../assets/photos/protection-incendie.png';

// Projets marqués « accueil: true », triés par ordre
const projets = (await getCollection('projets'))
  .filter((p) => p.data.accueil)
  .sort((a, b) => a.data.ordre - b.data.ordre);

const metiers = [
  {
    href: '/construction-bois/',
    titre: 'Construction bois',
    texte: 'Construire avec le bois. Transformer avec justesse.',
    photo: photoConstruction,
  },
  { href: '/etude-bois/', titre: 'Étude bois', texte: 'Le projet se construit avant le chantier.', photo: photoEtude },
  {
    href: '/protection-incendie/',
    titre: 'Protection incendie',
    texte: 'Anticiper les exigences. Accompagner le projet.',
    photo: photoIncendie,
  },
];
---

<Base titre="Construction bois, étude bois et protection incendie">
  <!-- Ouverture plein écran : photo + titre -->
  <section class="hero-immersif">
    <div class="hero-fond">
      <Image
        src={photoHero}
        alt="Levage d’un élément de construction bois sur un chantier au-dessus du Léman"
        widths={[800, 1400, 1920]}
        quality={70}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap hero-contenu">
      <p class="eyebrow">CONSTRUCTION BOIS · PUIDOUX / SUISSE ROMANDE</p>
      <h1>
        <span>Étudier.</span>
        <span>Construire.</span>
        <span>Sécuriser.</span>
      </h1>
      <div class="hero-bas">
        <p>
          Construction bois, étude technique et protection incendie en Suisse romande. Depuis Puidoux, nous relions la
          réflexion du bureau à la réalité du chantier.
        </p>
        <div class="hero-actions">
          <a class="bouton-clair" href="/contact/">
            Votre projet commence ici <span aria-hidden="true">↗</span>
          </a>
          <a class="hero-tel" href={`tel:${entreprise.telephoneLien}`}>
            {entreprise.telephone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="expertise wrap">
    <div class="section-heading" data-anim>
      <div>
        <p class="eyebrow">NOS COMPÉTENCES</p>
        <h2>
          Un seul interlocuteur.
          <br />
          De l’étude au chantier.
        </h2>
      </div>
    </div>
    <div class="metiers-grille" data-anim-cascade>
      {metiers.map((m, i) => (
        <a class="metier-carte" href={m.href}>
          <div class="metier-photo">
            <Image src={m.photo} alt="" widths={[500, 900]} sizes="(max-width: 600px) 100vw, 33vw" />
          </div>
          <div class="card-top">
            <span class="eyebrow">0{i + 1}</span>
            <span aria-hidden="true">↗</span>
          </div>
          <h3>{m.titre}</h3>
          <p>{m.texte}</p>
          <span class="text-link">Découvrir notre approche →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Ce qui distingue SANSO : le bois et la protection incendie réunis -->
  <section class="peach">
    <div class="wrap about-text atout">
      <div>
        <p class="eyebrow">LA DIFFÉRENCE SANSO</p>
        <h2>Le bois et la sécurité incendie, pensés ensemble.</h2>
      </div>
      <div>
        <p>
          {entreprise.responsable} est technicien ES en construction bois et spécialiste en protection incendie AEAI.
          Les exigences de protection incendie sont ainsi prises en compte dès les premiers choix constructifs.
        </p>
        <ul class="atout-faits">
          <li>10 ans d’expérience dans le bois</li>
          <li>Formé sur le terrain (CFC), puis en école (technicien ES)</li>
          <li>SANSO Concept fondée en 2025</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="approach">
    <div class="wrap approach-grid" data-anim>
      <div>
        <p class="eyebrow">L’ÉTUDE RENCONTRE LE CHANTIER</p>
        <h2>Du premier trait au dernier assemblage.</h2>
      </div>
      <div>
        <p>
          Nous pensons les projets avec leur mise en œuvre. Les choix de structure, les détails et les interfaces sont
          étudiés pour apporter des réponses concrètes aux contraintes du bâtiment et du chantier.
        </p>
        <a class="text-link" href="/a-propos/">
          À propos de SANSO <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
    <div class="approach-word" aria-hidden="true">
      MAÎTRISE.
    </div>
  </section>

  <section class="wrap selected">
    <div class="section-heading" data-anim>
      <div>
        <p class="eyebrow">SUR LE TERRAIN</p>
        <h2>Réalisations.</h2>
      </div>
      <a class="text-link" href="/projets/">
        Toutes les réalisations <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-list">
      {projets.map((p, i) => (
        <ProjetCarte projet={p} numero={i + 1} />
      ))}
    </div>
  </section>

  <Cta />
</Base>
