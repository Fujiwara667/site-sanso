---
// Page Contact — le formulaire est envoyé à /contact.php (script PHP sur l'hébergement Infomaniak)
import Base from '../layouts/Base.astro';
import entreprise from '../data/entreprise.json';
const adresseMaps = encodeURIComponent(`${entreprise.adresse} ${entreprise.npa} ${entreprise.localite}`);
---

<Base
  titre="Contact"
  description="Pour une demande de travaux, une étude bois ou un mandat de protection incendie, contactez SANSO CONCEPT à Puidoux."
>
  <section class="wrap page-title">
    <p class="eyebrow">CONTACT</p>
    <h1>Contact</h1>
    <p class="introduction">Pour vos demandes de travaux, d’étude bois ou de protection incendie.</p>
  </section>

  <section class="wrap contact-details" aria-label="Coordonnées">
    <div>
      <p class="eyebrow">E-mail</p>
      <a class="contact-email" href={`mailto:${entreprise.email}`}>
        {entreprise.email}
      </a>
    </div>
    <div>
      <p class="eyebrow">Téléphone</p>
      <a class="contact-phone" href={`tel:${entreprise.telephoneLien}`}>
        {entreprise.telephone}
      </a>
    </div>
    <div>
      <p class="eyebrow">Adresse</p>
      <p>
        {entreprise.adresse}
        <br />
        {entreprise.npa} {entreprise.localite}
      </p>
      <a
        class="text-link"
        target="_blank"
        rel="noreferrer"
        href={`https://www.google.com/maps/search/?api=1&query=${adresseMaps}`}
      >
        Voir l’adresse <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="wrap form-section">
    <div>
      <h2>Votre demande</h2>
      <p>
        Indiquez la prestation souhaitée, le lieu du projet et les travaux envisagés. Vous pouvez transmettre vos plans
        et documents par e-mail.
      </p>
    </div>
    <form id="contact-form" action="/contact.php" method="post">
      <div class="form-grid">
        <label>
          Nom / entreprise *<input autocomplete="name" maxlength="150" required name="name" />
        </label>
        <label>
          E-mail *<input type="email" autocomplete="email" maxlength="200" required name="email" />
        </label>
        <label>
          Téléphone
          <input type="tel" autocomplete="tel" maxlength="40" name="phone" />
        </label>
        <label>
          Prestation concernée
          <select name="subject">
            <option value="">Sélectionner une prestation</option>
            <option>Construction bois</option>
            <option>Étude bois</option>
            <option>Protection incendie</option>
            <option>Autre demande</option>
          </select>
        </label>
      </div>
      <label>
        Votre message *<textarea name="message" rows="5" minlength="10" maxlength="10000" required></textarea>
      </label>
      <!-- Anti-spam : champ invisible (piège) + heure d'ouverture du formulaire -->
      <label class="honeypot" aria-hidden="true" hidden>
        Site web
        <input tabindex="-1" autocomplete="off" name="website" />
      </label>
      <input type="hidden" name="t" value="" />
      <label class="consent">
        <input type="checkbox" required name="consent" />
        <span>
          J’accepte que les informations transmises soient utilisées pour répondre à ma demande.{' '}
          <a href="/confidentialite/">Politique de confidentialité</a>
        </span>
      </label>
      <button class="button" type="submit">
        Envoyer le message
      </button>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<script>
  // Envoi du formulaire sans recharger la page + message de confirmation
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statut = form?.querySelector<HTMLElement>('.form-status');
  const choix = form?.querySelector<HTMLSelectElement>('select[name="subject"]');
  const prestations: Record<string, string> = { CB: 'Construction bois', EB: 'Étude bois', PI: 'Protection incendie' };
  const selection = new URLSearchParams(window.location.search).get('prestation') || '';
  const prestation = prestations[selection] || '';
  if (choix) choix.value = prestation;
  const champT = form?.querySelector<HTMLInputElement>('input[name="t"]');
  if (champT) champT.value = String(Math.floor(Date.now() / 1000));

  form?.addEventListener(
    'invalid',
    () => {
      if (statut) {
        statut.className = 'form-status error';
        statut.textContent = 'Veuillez compléter les champs obligatoires.';
      }
    },
    true,
  );

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (bouton) bouton.disabled = true;
    if (statut) {
      statut.className = 'form-status';
      statut.textContent = 'Envoi en cours…';
    }
    try {
      const rep = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await rep.json().catch(() => ({}));
      if (!rep.ok || !data.ok) throw new Error(data.message || 'Erreur');
      form.reset();
      if (choix) choix.value = prestation;
      if (champT) champT.value = String(Math.floor(Date.now() / 1000));
      if (statut) {
        statut.classList.add('ok');
        statut.textContent = 'Votre message a été envoyé. Nous vous répondrons prochainement.';
      }
    } catch (err) {
      if (statut) {
        statut.classList.add('error');
        statut.textContent =
          'Votre message n’a pas pu être envoyé. Veuillez réessayer ou nous contacter à info@sanso-concept.ch.';
      }
    } finally {
      if (bouton) bouton.disabled = false;
    }
  });
</script>
