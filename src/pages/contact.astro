---
// Page Contact — le formulaire est envoyé à /contact.php (script PHP sur l'hébergement Infomaniak)
import Base from '../layouts/Base.astro';
import entreprise from '../data/entreprise.json';
const adresseMaps = encodeURIComponent(`${entreprise.adresse} ${entreprise.npa} ${entreprise.localite}`);
---

<Base titre="Contact">
  <section class="wrap page-title">
    <p class="eyebrow">PRENONS CONTACT</p>
    <h1>
      Un projet ?<br />
      Parlons-en.
    </h1>
  </section>

  <section class="peach">
    <div class="wrap contact-details" data-anim>
      <div>
        <p class="eyebrow">PUIDOUX / SUISSE ROMANDE</p>
        <p class="contact-area">
          Basés à Puidoux, nous intervenons principalement sur l’arc lémanique et dans les régions voisines de Suisse
          romande.
        </p>
        <a
          class="text-link"
          target="_blank"
          rel="noreferrer"
          href={`https://www.google.com/maps/search/?api=1&query=${adresseMaps}`}
        >
          Nous situer <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div>
        <a class="contact-email" href={`mailto:${entreprise.email}`}>
          {entreprise.email}
        </a>
        <a class="contact-phone" href={`tel:${entreprise.telephoneLien}`}>
          {entreprise.telephone}
        </a>
        <p>
          {entreprise.adresse}
          <br />
          {entreprise.npa} {entreprise.localite}
        </p>
      </div>
    </div>
  </section>

  <section class="wrap form-section" data-anim>
    <div>
      <p class="eyebrow">VOTRE DEMANDE</p>
      <h2>
        Les premières lignes
        <br />
        de votre projet.
      </h2>
      <p>Présentez-nous votre besoin. Pour des plans ou documents, nous vous répondrons par e-mail.</p>
    </div>
    <form id="contact-form" action="/contact.php" method="post">
      <div class="form-grid">
        <label>
          Nom / entreprise *<input autocomplete="name" maxlength="150" required name="name" />
        </label>
        <label>
          E-mail *<input type="email" autocomplete="email" maxlength="200" required name="email" />
        </label>
        <label>
          Téléphone
          <input type="tel" autocomplete="tel" maxlength="40" name="phone" />
        </label>
        <label>
          Votre besoin
          <select name="subject">
            <option>Construction bois</option>
            <option>Étude bois</option>
            <option>Protection incendie</option>
            <option>Autre demande</option>
          </select>
        </label>
      </div>
      <label>
        Votre message *<textarea name="message" rows="5" minlength="10" maxlength="10000" required></textarea>
      </label>
      <!-- Anti-spam : champ invisible (piège) + heure d'ouverture du formulaire -->
      <label class="honeypot" aria-hidden="true">
        Site web
        <input tabindex="-1" autocomplete="off" name="website" />
      </label>
      <input type="hidden" name="t" value="" />
      <label class="consent">
        <input type="checkbox" required name="consent" />
        <span>
          J’accepte que mes données soient utilisées pour répondre à ma demande.{' '}
          <a href="/confidentialite/">Confidentialité</a>
        </span>
      </label>
      <button class="button" type="submit">
        Envoyer la demande ↗
      </button>
      <p class="small">
        Pour un contact direct : <a href={`mailto:${entreprise.email}`}>{entreprise.email}</a>.
      </p>
      <p class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<script>
  // Envoi du formulaire sans recharger la page + message de confirmation
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statut = form?.querySelector<HTMLElement>('.form-status');
  const champT = form?.querySelector<HTMLInputElement>('input[name="t"]');
  if (champT) champT.value = String(Math.floor(Date.now() / 1000));

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (bouton) bouton.disabled = true;
    if (statut) {
      statut.className = 'form-status';
      statut.textContent = 'Envoi en cours…';
    }
    try {
      const rep = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await rep.json().catch(() => ({}));
      if (!rep.ok || !data.ok) throw new Error(data.message || 'Erreur');
      form.reset();
      if (statut) {
        statut.classList.add('ok');
        statut.textContent = 'Merci, votre demande a bien été envoyée. Nous vous répondons rapidement.';
      }
    } catch (err) {
      if (statut) {
        statut.classList.add('error');
        statut.textContent =
          (err as Error).message !== 'Erreur'
            ? (err as Error).message
            : 'L’envoi a échoué. Écrivez-nous directement à info@sanso-concept.ch.';
      }
    } finally {
      if (bouton) bouton.disabled = false;
    }
  });
</script>
