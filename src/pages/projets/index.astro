---
// Page Projets : liste tous les fichiers de src/content/projets/, avec filtres par métier
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import ProjetCarte from '../../components/ProjetCarte.astro';

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
const contientExemples = projets.some((p) => p.data.exemple);
const filtres = ['Tous', 'Construction bois', 'Étude bois', 'Protection incendie'];
---

<Base titre="Projets">
  <section class="wrap page-title" data-anim>
    <p class="eyebrow">03 / EXPLORER</p>
    <h1>Projets.</h1>
    <p>Des idées qui prennent forme.</p>
  </section>

  <section class="wrap projects-page">
    <div class="filters" aria-label="Filtrer les projets">
      {filtres.map((f, i) => (
        <button type="button" data-filtre={f} aria-pressed={i === 0 ? 'true' : 'false'} class={i === 0 ? 'active' : ''}>
          {f}
        </button>
      ))}
    </div>
    {contientExemples && (
      <p class="example-note">
        Les projets ci-dessous sont des exemples de présentation. Nos références seront ajoutées prochainement.
      </p>
    )}
    <div class="project-list">
      {projets.map((p, i) => (
        <ProjetCarte projet={p} numero={i + 1} />
      ))}
    </div>
  </section>

  <Cta />
</Base>

<script>
  // Filtres : affiche uniquement les projets du métier sélectionné
  const boutons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const projets = document.querySelectorAll<HTMLElement>('.project');
  boutons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filtre;
      boutons.forEach((x) => {
        const actif = x === b;
        x.classList.toggle('active', actif);
        x.setAttribute('aria-pressed', String(actif));
      });
      projets.forEach((p) => (p.hidden = f !== 'Tous' && p.dataset.categorie !== f));
    }),
  );
</script>
