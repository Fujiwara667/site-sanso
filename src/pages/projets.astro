---
import Base from '../layouts/Base.astro';
import { referencesPubliees as references } from '../data/projets';
import ProjetReference from '../components/ProjetReference.astro';
---

<Base
  titre="Projets"
  description="Projets de construction bois, d’étude bois et de protection incendie de SANSO CONCEPT."
>
  <section class="wrap page-title">
    <h1>PROJETS</h1>
  </section>
  <section class="wrap references" aria-label="Liste des projets">
    {references.map((projet) => (
      <ProjetReference projet={projet} />
    ))}
    {references.length === 0 && <p class="projects-empty">Nos références seront présentées prochainement.</p>}
  </section>
</Base>
