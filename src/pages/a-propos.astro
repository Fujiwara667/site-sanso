---
// Page À propos
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import photo from '../assets/photos/a-propos.webp';
import entreprise from '../data/entreprise.json';
---

<Base
  titre="À propos"
  description="Entreprise de construction bois et bureau d’étude bois et de protection incendie à Puidoux."
>
  <section class="wrap page-title">
    <p class="eyebrow">ENTREPRISE</p>
    <h1>SANSO CONCEPT</h1>
    <p class="introduction">
      Entreprise de construction bois et bureau d’étude bois et de protection incendie à Puidoux.
    </p>
  </section>
  <div class="about-photo">
    <Image
      src={photo}
      alt="Assemblages et structure en bois d’un ouvrage extérieur"
      widths={[800, 1400, 1920]}
      quality={70}
      sizes="100vw"
    />
  </div>
  <section class="wrap about-text">
    <h2>Nos activités</h2>
    <div class="prose">
      <p>
        Nous intervenons auprès des particuliers, des architectes et des entreprises pour des projets de construction,
        de rénovation et de transformation en Suisse romande.
      </p>
      <p>
        La construction bois couvre la réalisation des travaux. L’étude bois comprend la conception, les calculs et les
        plans. La protection incendie concerne tous types de bâtiments.
      </p>
      <p>Les trois activités sont proposées séparément ou dans un même mandat.</p>
    </div>
  </section>
  <section class="wrap person">
    <div>
      <p class="eyebrow">DIRECTION</p>
      <h2>{entreprise.responsable}</h2>
    </div>
    <div>
      <p class="qualifications">Technicien ES en construction bois{'\n'}Spécialiste en protection incendie AEAI</p>
      <a class="text-link" href="/contact/">
        Contactez-nous <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <Cta />
</Base>
