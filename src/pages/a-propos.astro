---
// Page À propos
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import photo from '../assets/photos/a-propos.webp';
import entreprise from '../data/entreprise.json';
---

<Base
  titre="À propos"
  description="Basé à Puidoux, SANSO CONCEPT intervient en construction bois, en étude bois et en protection incendie. Nous travaillons avec les particuliers, les architectes et les entreprises pour des projets de construction, de rénovation et de transformation en Suisse romande."
>
  <section class="wrap page-title">
    <p class="eyebrow">À PROPOS</p>
    <h1>SANSO CONCEPT.</h1>
  </section>
  <div class="about-photo">
    <Image
      src={photo}
      alt="Assemblages et structure en bois d’un ouvrage extérieur"
      widths={[800, 1400, 1920]}
      quality={70}
      sizes="100vw"
    />
  </div>
  <section class="wrap about-text">
    <h2>L’entreprise</h2>
    <p>
      Basé à Puidoux, SANSO CONCEPT intervient en construction bois, en étude bois et en protection incendie. Nous
      travaillons avec les particuliers, les architectes et les entreprises pour des projets de construction, de
      rénovation et de transformation en Suisse romande.
    </p>
  </section>
  <section class="peach">
    <div class="wrap about-text">
      <h2>Notre manière de travailler</h2>
      <p>
        Nous commençons par définir vos besoins et l’étendue de notre intervention. Nous étudions ensuite les solutions
        en tenant compte du bâtiment, du budget et des contraintes de réalisation. Vous disposez d’un interlocuteur
        direct pour les prestations qui nous sont confiées.
      </p>
    </div>
  </section>
  <section class="wrap person">
    <div>
      <p class="eyebrow">VOTRE INTERLOCUTEUR</p>
      <h2>{entreprise.responsable}</h2>
      <p class="eyebrow">{entreprise.fonction}</p>
    </div>
    <div>
      <p class="qualifications">Technicien ES en construction bois{'\n'}Spécialiste en protection incendie AEAI</p>
      <p>
        Nicolas Sansonnens est votre interlocuteur pour les travaux de construction bois, les études techniques et les
        mandats de protection incendie.
      </p>
      <a class="text-link" href="/contact/">
        Contactez-nous <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <Cta />
</Base>
